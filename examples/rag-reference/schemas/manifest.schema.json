{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aitrainer/rag/manifest.schema.json",
  "title": "RAG corpus manifest",
  "type": "object",
  "required": ["schema_version", "corpus_id", "corpus_version", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_version": {"type": "string", "minLength": 1},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "title", "owner", "document_version", "deletion_status", "tenant", "allowed_roles", "classification", "effective_date", "expires_at"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "document_version": {"type": "string", "minLength": 1},
          "deletion_status": {"type": "string", "enum": ["active", "deletion_pending", "legal_hold"]},
          "tenant": {"type": "string", "minLength": 1},
          "allowed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "classification": {"type": "string", "enum": ["public", "internal", "confidential", "restricted", "untrusted"]},
          "effective_date": {"type": "string", "format": "date"},
          "expires_at": {"type": "string", "format": "date"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "quarantine": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": false
}
