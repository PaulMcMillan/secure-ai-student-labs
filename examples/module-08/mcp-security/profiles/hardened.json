{
  "profile_id": "training-policy-hardened",
  "source": {
    "owner": "platform-security",
    "version_pinned": true,
    "digest_verified": true,
    "dependency_lock_reviewed": true,
    "startup_command_reviewed": true,
    "capability_baseline_recorded": true,
    "change_requires_reapproval": true
  },
  "least_privilege": {
    "default_deny": true,
    "non_elevated": true,
    "filesystem_roots": ["training-data/policies"],
    "environment_allowlist": ["MCP_TRAINING_MODE"],
    "egress_allowlist": ["auth.training.example", "api.training.example"]
  },
  "identity": {
    "protected_resource_metadata": true,
    "resource_parameter_on_both_requests": true,
    "issuer_validation": true,
    "audience_validation": true,
    "pkce_method": "S256",
    "exact_redirect_match": true,
    "single_use_state": true,
    "read_write_scopes_split": true,
    "object_and_tenant_authorization": true,
    "token_passthrough": false,
    "downstream_token_separate": true,
    "access_token_ttl_seconds": 600,
    "refresh_token_rotation": true,
    "protocol_version": "2026-07-28",
    "per_request_protocol_and_capability_validation": true,
    "every_request_authorized": true,
    "server_discover_implemented": true,
    "client_info_used_as_authentication": false,
    "issuer_and_token_audience_validation": true
  },
  "runtime": {
    "local_transport": "stdio",
    "shell_wrapper": false,
    "local_http_bind": "disabled",
    "origin_validation": true,
    "https_required_for_remote": true,
    "authenticate_every_remote_request": true,
    "ssrf_address_filtering": true,
    "redirect_revalidation": true,
    "dns_rebinding_defense": true,
    "secret_storage": "external-reference",
    "literal_secrets_in_config": false,
    "sandboxed": true,
    "resource_limits": true,
    "startup_and_call_timeouts": true,
    "stdout_protocol_only": true
  },
  "tools": {
    "default_deny": true,
    "approved_tools": ["lookup_policy"],
    "schema_hash_baseline": true,
    "strict_input_schema": true,
    "additional_properties_rejected": true,
    "semantic_validation": true,
    "object_and_tenant_authorization": true,
    "raw_shell_interpolation": false,
    "risk_tiers_assigned": true,
    "sensitive_actions_require_approval": true,
    "idempotency_and_deduplication": true,
    "unknown_outcomes_not_retried": true,
    "output_treated_as_untrusted": true,
    "output_redaction_and_size_limit": true,
    "annotations_used_as_authorization": false,
    "pinned_tool_inventory": true,
    "side_effect_approval": true
  },
  "operations": {
    "security_event_schema": true,
    "sensitive_value_redaction_tested": true,
    "inventory_and_config_hash_monitored": true,
    "read_write_and_approval_metrics": true,
    "auth_policy_origin_alerts": true,
    "sensitive_output_alert": true,
    "synthetic_read_canary": true,
    "disable_and_absence_tested": true,
    "credential_and_grant_revocation": true,
    "incident_runbook": true,
    "recovery_requires_reapproval": true,
    "evidence_retention_defined": true
  }
}
